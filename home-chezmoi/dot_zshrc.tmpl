{{- /* one zshrc for every machine; branch on the OS data from .chezmoi.toml.tmpl, never on hostname */ -}}
{{- if .uses_nix }}
# home-manager session vars (home.sessionPath, XDG dirs); home-manager no longer owns .zshrc
for _f in "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh" "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"; do
    [ -f "$_f" ] && { source "$_f"; break }
done
unset _f
{{- end }}

# path; mise shims first so mise-managed tools win over system copies and oh-my-zsh plugins (fzf, mise) find them
path=("$HOME/.local/share/mise/shims" $path)
path+=("$HOME/.local/bin" "$HOME/.npm-global/bin")
[ -d "$HOME/.config/kitty/scripts" ] && path+="$HOME/.config/kitty/scripts"
# manually installed neovim builds, when present
for _d in /opt/nvim-macos-arm64/bin /opt/nvim-linux-x86_64/bin; do
    [ -d "$_d" ] && path+="$_d"
done
unset _d

# oh-my-zsh
export ZSH="{{ .omz_dir }}"
{{- if .uses_nix }}
# $ZSH is a read-only store path: cache and completions go to $HOME, self-update is off
export ZSH_CACHE_DIR="$HOME/.cache/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR/completions"
zstyle ':omz:update' mode disabled
{{- end }}
ZSH_THEME="robbyrussell"
plugins=(git fzf mise gh)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# zsh plugins from the package manager; zsh-vi-mode first, syntax-highlighting last
for _p in zsh-vi-mode/zsh-vi-mode.plugin.zsh zsh-autosuggestions/zsh-autosuggestions.zsh zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
    for _d in "{{ .zsh_plugin_dir }}" "$ZSH/custom/plugins"; do
        [ -f "$_d/$_p" ] && { source "$_d/$_p"; break }
    done
done
unset _p _d

# env
(( $+commands[nvim] )) && export EDITOR=nvim
export XDG_DATA_HOME="$HOME/.local/share"
{{- if .is_regular_linux }}
export LANG=en_US.UTF-8
{{- end }}

# tool hooks
(( $+commands[mise] )) && eval "$(mise activate zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[atuin] )) && eval "$(atuin init zsh)"
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"
{{- if .has_conda }}

# conda; first install found wins
for _c in /opt/homebrew/Caskroom/miniconda/base /opt/miniconda3 "$HOME/miniconda3"; do
    if [ -x "$_c/bin/conda" ]; then
        if __conda_setup="$("$_c/bin/conda" shell.zsh hook 2>/dev/null)"; then
            eval "$__conda_setup"
        else
            source "$_c/etc/profile.d/conda.sh"
        fi
        unset __conda_setup
        break
    fi
done
unset _c
{{- end }}

# aliases
if (( $+commands[eza] )); then
    alias l="eza -1 --group-directories-first --icons=auto"
    alias le="eza --group-directories-first --icons=auto"
    alias led="eza --group-directories-last --icons=auto"
    alias la="eza -a --group-directories-first --icons=auto"
    alias larth="eza -lah --git -snew --group-directories-first --icons=auto"
    alias ll="eza -lh --git --group-directories-first --icons=auto"
    alias lla="eza -lah --git --group-directories-first --icons=auto"
    alias lt="eza --tree --level=2 --group-directories-first --icons=auto"
    alias lta="eza --tree --level=2 -a --group-directories-first --icons=auto"
fi
(( $+commands[chezmoi] )) && alias ch="chezmoi"
{{- if .is_mac }}
alias icat="kitty +kitten icat"
{{- end }}
if (( $+commands[nu] )); then
    # nushell as a cli tool: `nuc ls`, `cat data.json | nuc '$in | from json'`
    alias nuc="nu --stdin -c"
    # file input: `nuf config.toml '| get database'`
    nuf () {
        local file="$1"; shift
        nu -c "open '$file' $*"
    }
fi
{{- if not .is_mac }}

# send <file>...: taildrop files to the macbook; receive them there with `getfiles`
send() {
    if [ "$#" -eq 0 ]; then echo "usage: send <file>..."; return 1; fi
    tailscale file cp "$@" stans-macbook-pro:
}
# drop WAYLAND_DISPLAY when its socket is missing (ssh/tty sessions) so wl-copy fails fast
if [[ -n "${WAYLAND_DISPLAY:-}" ]] && [[ -n "${XDG_RUNTIME_DIR:-}" ]] && [[ ! -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]]; then
    unset WAYLAND_DISPLAY
fi
{{- end }}
